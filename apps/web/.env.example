# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------

# Public base URL of the deployed app.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Convex
# -----------------------------------------------------------------------------

# Active Convex target used by the app itself.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Stable secret used to encrypt persisted settings in Convex.
YOKAI_ENCRYPTION_KEY=

# Optional comma-separated origins allowed to call Next.js Server Actions.
YOKAI_ALLOWED_ORIGINS=

# Recommended in production if you expose the rollover endpoint to a scheduler.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------

# Optional Vercel AI Gateway key.
AI_GATEWAY_API_KEY=

# Optional env-only token forwarded into the sandbox when available.
VERCEL_OIDC_TOKEN=
