# -----------------------------------------------------------------------------
# App Runtime
# -----------------------------------------------------------------------------

# Public base URL used for metadata and canonical URLs.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Convex
# -----------------------------------------------------------------------------

# Active Convex deployment used by the app and helper commands.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Stable secret used to encrypt persisted settings in Convex.
YOKAI_ENCRYPTION_KEY=

# Optional comma-separated origins allowed to call Next.js Server Actions.
YOKAI_ALLOWED_ORIGINS=

# Recommended in production if you expose the rollover endpoint to a scheduler.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------

# Optional AI Gateway key used for model discovery, credit snapshots, and sandbox auth.
AI_GATEWAY_API_KEY=
