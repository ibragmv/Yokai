# Public application URL used for local callbacks and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex development deployment used by `bun run convex:sync:dev`.
CONVEX_DEPLOYMENT=

# Convex HTTP endpoints used by the local Next.js app.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional integrations.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
